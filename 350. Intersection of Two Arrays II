class Solution {
    public int[] intersect(int[] nums1, int[] nums2) {
        int n = 0;
    int a = 0;
    int b = 0;

    if (nums1.length < nums2.length) {
      n = nums1.length;
    } else
      n = nums2.length;
    int arr1[] = new int[n];

    for (int i = 0; i < nums1.length; i++) {
      for (int j = 0; j < nums2.length; j++) {
        if (nums1[i] == nums2[j]) {
          arr1[a] = nums2[j];
          nums2[j]=-1;
          a++;
          b++;
          break;
        }
      }
    }

    int[] result = new int[a];
        for (int i = 0; i < a; i++) {
            result[i] = arr1[i];
        }
        return result;
    }
}
